# OpenAI
OPENAI_API_KEY=sk-xxxx
# Optional: override the OpenAI-compatible upstream host (no protocol), e.g. a proxy
BASE_URL=
# Optional: "http" or "https", defaults to "https"
PROTOCOL=
# Optional: OpenAI organization id
OPENAI_ORG_ID=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Optional: override the Anthropic API base URL, defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=

# Google (Gemini)
GEMINI_API_KEY=
# Optional: override the Gemini API base URL, defaults to https://generativelanguage.googleapis.com
GEMINI_BASE_URL=

# Access control
# Comma-separated list of access codes. Leave empty to disable access control.
CODE=
# Optional: restrict outbound requests to this proxy
PROXY_URL=
